// Test source for the fixture home. Names only.
{
  "version": 1,
  "vars": { "DIR": "C:\\fake\\tools" },
  "servers": {
    "demo-browser-a": {
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "C:\\demo\\scripts\\demo-browser-a-shared.cmd"],
      "startup_timeout_sec": 120
    },
    "demo-browser-b": {
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "C:\\demo\\scripts\\demo-browser-b-shared.cmd"],
      "startup_timeout_sec": 120
    },
    // the env (PATH, USER_AGENT) is dropped everywhere except Codex
    "demo-npx": {
      "transport": "stdio",
      "command": "npx.cmd",
      "args": ["--package=@demo/mcp@latest", "demo-npx-mcp"],
      "keep_live_env": ["codex"]
    },
    // URL changed on purpose: every tool must be updated
    "demo-remote": {
      "transport": "http",
      "url": "https://demo-remote.example.test/api/mcp/v2",
      "auth": "oauth"
    },
    "new-stdio": {
      "transport": "stdio",
      "command": "node",
      "args": ["{DIR}\\server.js", "--flag"],
      "env": { "MODE": "test" },
      "description": "added to every tool"
    },
    "new-http": { "transport": "http", "url": "https://new.example.test/mcp" },
    "opencode-only": {
      "transport": "stdio",
      "command": "npx",
      "args": ["only-here"],
      "tools": ["opencode"]
    }
  },
  "retired": { "opencode": ["playwright"] },
  "unmanaged": { "codex": ["node_repl"] }
}
